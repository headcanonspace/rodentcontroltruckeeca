# Apache / cPanel configuration for Rodent Control Truckee

RewriteEngine On
RewriteBase /

# 1. 301 Permanent Redirects for legacy .html paths to clean URLs
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/about\.html[\s?] [NC]
RewriteRule ^about\.html$ /about [R=301,L]

RewriteCond %{THE_REQUEST} \s/contact\.html[\s?] [NC]
RewriteRule ^contact\.html$ /contact [R=301,L]

RewriteCond %{THE_REQUEST} \s/privacy-policy\.html[\s?] [NC]
RewriteRule ^privacy-policy\.html$ /privacy-policy [R=301,L]

RewriteCond %{THE_REQUEST} \s/rat-removal-truckee\.html[\s?] [NC]
RewriteRule ^rat-removal-truckee\.html$ /rat-removal-truckee [R=301,L]

RewriteCond %{THE_REQUEST} \s/mice-control-truckee\.html[\s?] [NC]
RewriteRule ^mice-control-truckee\.html$ /mice-control-truckee [R=301,L]

RewriteCond %{THE_REQUEST} \s/rodent-control-downtown-truckee\.html[\s?] [NC]
RewriteRule ^rodent-control-downtown-truckee\.html$ /rodent-control-downtown-truckee [R=301,L]

RewriteCond %{THE_REQUEST} \s/rodent-control-glenshire\.html[\s?] [NC]
RewriteRule ^rodent-control-glenshire\.html$ /rodent-control-glenshire [R=301,L]

RewriteCond %{THE_REQUEST} \s/blog\.html[\s?] [NC]
RewriteRule ^blog\.html$ /blog [R=301,L]

# Redirect /services and /locations root paths to homepage
RewriteRule ^services/?$ / [R=301,L]
RewriteRule ^locations/?$ / [R=301,L]

# 301 Redirects for rat removal slug updates
Redirect 301 /services/rat-removal /rat-removal-truckee
Redirect 301 /services/rat-removal-truckee /rat-removal-truckee
Redirect 301 /rat-removal /rat-removal-truckee
Redirect 301 /services/rat-removal.html /rat-removal-truckee
Redirect 301 /services/rat-removal-truckee.html /rat-removal-truckee

# 301 Redirects for mice control slug updates
Redirect 301 /services/mice-control /mice-control-truckee
Redirect 301 /services/mice-control-truckee /mice-control-truckee
Redirect 301 /mice-control /mice-control-truckee
Redirect 301 /services/mice-control.html /mice-control-truckee
Redirect 301 /services/mice-control-truckee.html /mice-control-truckee

# 2. Clean URLs - Serve .html files without requiring .html extension in URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. Block direct browser access to SQLite database files
<Files "*.sqlite">
    Order Deny,Allow
    Deny from all
</Files>
